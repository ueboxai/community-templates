# 模板包是二进制，任何换行转换都会改掉 sha256，清单就对不上了
*.zip binary

# 文本一律以 LF 提交，避免不同机器上生成的清单/哈希不一致
*.json text eol=lf
*.md   text eol=lf
*.py   text eol=lf
*.yml  text eol=lf
.editorconfig  text eol=lf
.gitattributes text eol=lf
.gitignore     text eol=lf
CODEOWNERS     text eol=lf

# 模板源码原样保存，不做任何换行转换：打包出来的字节要和仓库里的一致。
# 放在最后，覆盖上面按扩展名的规则
templates/** -text
